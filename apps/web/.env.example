# Copy to .env.local (git-ignored). Never commit real values or CLI tokens.
# Local SpacetimeDB (default):
NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:3001
NEXT_PUBLIC_SPACETIME_DATABASE=earthshare-game

# Maincloud: replace the two lines above with these, using your own published database name.
# NEXT_PUBLIC_SPACETIME_URI=wss://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIME_DATABASE=<your-database-name>
